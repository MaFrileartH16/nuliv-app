{
  "expo": {
    "name": "Nuliv",
    "slug": "nuliv",
    "version": "1.0.0",
    "scheme": "nuliv",
    "orientation": "portrait",
    "platforms": ["android"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.mafrilearth.nuliv",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f51ed487-cb4a-44bc-84dc-992d23f5ec45"
      }
    },
    "owner": "mafrilearth"
  }
}
